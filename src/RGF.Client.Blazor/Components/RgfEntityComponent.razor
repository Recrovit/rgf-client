@* RGF-DOC: rgf.client.blazor-ui.entity-ui *@
@if (_initialized && Manager != null)
{
    <CascadingValue Value="this" IsFixed="true">
    <RgfComponentWrapper @key="Manager.EntityDomId">
        @if (!EntityParameters.FormOnly)
        {
            if (EntityParameters.TitleTemplate != null)
            {
                @EntityParameters.TitleTemplate(Manager)
            }
            <div id="@Manager.EntityDomId"
                 class="@($"recro-grid recro-grid-base{(EntityParameters.DisplayMode == RfgDisplayMode.Tree ? " rg-tree" : "")} rg-ent-{Manager.EntityDesc.EntityId}")"
                 style="@(EntityParameters.DisplayMode == RfgDisplayMode.Chart ? "width:100%;min-width:0" : "width:fit-content")">
                @if (!string.IsNullOrEmpty(Manager.EntityDesc.CRUD))
                {
                    @ToolbarTemplate(EntityParameters)
                    <div class="rgf-entity-grid" style="@(EntityParameters.DisplayMode == RfgDisplayMode.Grid ? null : "display:none")">
                        @if (IsChartWorkspace || EntityParameters.DisplayMode == RfgDisplayMode.Grid)
                        {
                            @GridTemplate(EntityParameters)
                        }
                    </div>
                    if (_isTreeInitialized && TreeTemplate != null)
                    {
                        <div class="rgf-entity-tree" style="@(EntityParameters.DisplayMode == RfgDisplayMode.Tree ? null : "display:none")">
                            @if (IsChartWorkspace || EntityParameters.DisplayMode == RfgDisplayMode.Tree)
                            {
                                @TreeTemplate(EntityParameters)
                            }
                        </div>
                    }
                    <div class="rgf-entity-chart" style="@(EntityParameters.DisplayMode == RfgDisplayMode.Chart ? "width:100%;min-height:400px" : "display:none")">
                        @if (IsChartWorkspace && _isChartInitialized && ChartTemplate != null)
                        {
                            @ChartTemplate(EntityParameters)
                        }
                    </div>
                    if (EntityParameters.DisplayMode != RfgDisplayMode.Chart)
                    {
                        @PagerTemplate(EntityParameters)
                    }
                    @FilterTemplate(EntityParameters)
                }
                else
                {
                    @_recroDict.GetRgfUiString("AccessDenied")
                }
            </div>
        }
        @if (_showFormView)
        {
            @FormTemplate(EntityParameters)
        }
        @if (!IsChartWorkspace && _isChartInitialized && ChartTemplate != null)
        {
            @ChartTemplate(EntityParameters)
        }
        @if (_entityEditor != null)
        {
            @_entityEditor
        }
    </RgfComponentWrapper>
    </CascadingValue>
}
else if (!EntityParameters.DeferredInitialization)
{
    if (LoadingIndicator != null)
    {
        @LoadingIndicator
    }
    else if (RgfBlazorConfiguration.TryGetComponentType(RgfBlazorConfiguration.ComponentType.LoadingIndicator, out var componentType))
    {
        <DynamicComponent Type="componentType" Parameters="@(new Dictionary<string, object> { ["LoadingIndicatorParameters"] = LoadingIndicatorParameters ?? new RgfLoadingIndicatorParameters { Text = _recroDict.GetRgfUiString("Loading") } })" />
    }
    else
    {
        <p><em>Loading...</em></p>
    }
}

<RgfDynamicDialog @ref="_dynamicDialog" />

@code {

    /// <summary>Required settings retained for this entity instance.</summary>
    [Parameter, EditorRequired]
    public RgfEntityParameters EntityParameters { get; set; } = null!;

    /// <summary>Toolbar rendering with the entity settings.</summary>
    [Parameter, EditorRequired]
    public RenderFragment<RgfEntityParameters> ToolbarTemplate { get; set; } = null!;

    /// <summary>Grid rendering with the entity settings.</summary>
    [Parameter, EditorRequired]
    public RenderFragment<RgfEntityParameters> GridTemplate { get; set; } = null!;

    /// <summary>Optional tree rendering; the base entity falls back to grid when absent.</summary>
    [Parameter]
    public RenderFragment<RgfEntityParameters>? TreeTemplate { get; set; }

    /// <summary>Filter rendering with the entity settings.</summary>
    [Parameter, EditorRequired]
    public RenderFragment<RgfEntityParameters> FilterTemplate { get; set; } = null!;

    /// <summary>Pager rendering with the entity settings.</summary>
    [Parameter, EditorRequired]
    public RenderFragment<RgfEntityParameters> PagerTemplate { get; set; } = null!;

    /// <summary>Form rendering with the entity settings.</summary>
    [Parameter, EditorRequired]
    public RenderFragment<RgfEntityParameters> FormTemplate { get; set; } = null!;

    /// <summary>Optional chart rendering with the entity settings.</summary>
    [Parameter]
    public RenderFragment<RgfEntityParameters>? ChartTemplate { get; set; }

    /// <summary>Optional loading fragment shown before automatic initialization completes.</summary>
    [Parameter]
    public RenderFragment? LoadingIndicator { get; set; }

    /// <summary>Settings for the registered loading indicator when no fragment is supplied.</summary>
    [Parameter]
    public RgfLoadingIndicatorParameters? LoadingIndicatorParameters { get; set; }
}
