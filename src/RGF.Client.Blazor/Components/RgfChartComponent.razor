@using Recrovit.RecroGridFramework.Client.Blazor.Parameters

@if (_showComponent)
{
    @if (IsWorkspace && !_contentReady)
    {
        <p><em>@_recroDict.GetRgfUiString("Loading")</em></p>
    }
    else if (IsWorkspace)
    {
        <div class="rgf-chart-workspace" style="width:100%;min-width:0">
            @ContentTemplate(this)
            @FooterTemplate(this)
        </div>
    }
    else
    {
        @_chartDialog
    }
}

<RgfDynamicDialog @ref="_dynamicDialog" />

@code {

    [Parameter, EditorRequired]
    public RgfEntityParameters EntityParameters { get; set; } = null!;

    [Parameter]
    public bool Embedded { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment<RgfChartComponent> ContentTemplate { get; set; } = null!;

    [Parameter, EditorRequired]
    public RenderFragment<RgfChartComponent> FooterTemplate { get; set; } = null!;
}
