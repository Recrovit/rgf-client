@using System.Text.Encodings.Web
@* RGF-DOC: rgf.client.recroby.integration *@
<div @ref="_element" class="rgf-recroby-workspace" style="--rgf-toast-anchor: @ToastAnchorName;" data-mode="@_layout.Mode" data-collapsed="@_layout.IsCollapsed.ToString().ToLowerInvariant()">
    <div class="rgf-recroby-content"><CascadingValue Value="this" IsFixed="true">@ChildContent</CascadingValue></div>
    <RgfButton CssClass="rgf-recroby-launcher btn-primary" OnClick="Open"
               Tooltip="@RecroDict.GetRgfRecrobyString("OpenRecroby")"
               AdditionalAttributes="@(new() { ["hidden"] = !_layout.IsCollapsed, ["aria-label"] = RecroDict.GetRgfRecrobyString("OpenRecroby"), ["aria-expanded"] = "false" })"><i class="bi bi-robot" aria-hidden="true"></i> Recroby</RgfButton>
    <section class="rgf-recroby-panel card" aria-label="Recroby" hidden="@_layout.IsCollapsed">
        <header class="card-header d-flex flex-wrap align-items-center gap-2 @(ActiveGridContext?.Manager is not null ? "bg-success-subtle" : null)" data-drag-handle>
            <strong><i class="bi bi-robot" aria-hidden="true"></i> Recroby</strong>
            @if (ActiveGridContext is { } grid)
            {
                <RgfHtml TagName="span" CssClass="rgf-recroby-context"
                         Tooltip="@HtmlEncoder.Default.Encode(grid.DisplayName)"
                         AdditionalAttributes="@(new() { ["tabindex"] = "0" })">@grid.DisplayName</RgfHtml>
            }
            <RgfHtml TagName="div" CssClass="dropdown ms-auto rgf-recroby-desktop-controls"
                     Tooltip="@RecroDict.GetRgfRecrobyString("WindowLayout")">
                <button type="button" class="btn btn-outline-secondary dropdown-toggle" data-bs-toggle="dropdown" aria-expanded="false" aria-label="@RecroDict.GetRgfRecrobyString("WindowLayout")"><i class="bi bi-window" aria-hidden="true"></i></button>
                <ul class="dropdown-menu dropdown-menu-end">
                    @foreach (var mode in Enum.GetValues<RgfRecrobyWindowMode>())
                    {
                        var (icon, label) = mode switch
                        {
                            RgfRecrobyWindowMode.DockLeft => ("bi-layout-sidebar", RecroDict.GetRgfRecrobyString("DockLeft")),
                            RgfRecrobyWindowMode.DockRight => ("bi-layout-sidebar-reverse", RecroDict.GetRgfRecrobyString("DockRight")),
                            RgfRecrobyWindowMode.DockBottom => ("bi-window-dock", RecroDict.GetRgfRecrobyString("DockBottom")),
                            _ => ("bi-window", RecroDict.GetRgfRecrobyString("FloatingWindow"))
                        };
                        <li>
                            <RgfHtml TagName="button" CssClass="@($"dropdown-item {(_layout.Mode == mode ? "active" : "")}")"
                                     Tooltip="@label"
                                     OnClick="() => SetMode(mode)"
                                     AdditionalAttributes="@(new() { ["type"] = "button", ["data-dock"] = mode.ToString(), ["aria-label"] = label, ["aria-pressed"] = (_layout.Mode == mode).ToString().ToLowerInvariant() })">
                                <i class="bi @icon" aria-hidden="true"></i><span class="ms-2">@label</span>
                            </RgfHtml>
                        </li>
                    }
                </ul>
            </RgfHtml>
            <RgfButton CssClass="btn-outline-secondary" OnClick="Collapse"
                       Tooltip="@RecroDict.GetRgfRecrobyString("CollapseRecroby")"
                       AdditionalAttributes="@(new() { ["aria-label"] = RecroDict.GetRgfRecrobyString("CollapseRecroby") })">−</RgfButton>
        </header>
        <div class="card-header rgf-recroby-conversation-bar" @onkeydown="SwitcherKeyDown">
            @if (_editing != null)
            {
                <input type="text" class="form-control rgf-recroby-title-editor" aria-label="@RecroDict.GetRgfRecrobyString("ConversationTitle")" maxlength="100"
                       @bind="_editTitle" @bind:event="oninput" @onkeydown="RenameKeyDown" @onblur="CancelRename" />
            }
            else
            {
                <RgfButton Id="@_selectorId" CssClass="btn-outline-secondary rgf-recroby-selector" OnClick="ToggleSwitcher"
                           Tooltip="@SwitcherTooltip"
                           AdditionalAttributes="@(new() { ["data-action"] = "switch", ["aria-label"] = SwitcherAccessibleLabel, ["aria-haspopup"] = "dialog", ["aria-expanded"] = _switcherOpen.ToString().ToLowerInvariant(), ["aria-controls"] = _selectorId + "-list" })">
                    @if (HasMultipleTypes && _active != null)
                    {
                        <span class="rgf-recroby-type">@TypeLabel(_active.RecrobyType)</span>
                    }
                    <span class="rgf-recroby-title">@(_active is null ? null : DisplayTitle(_active))</span>
                    @if (!_switcherOpen && HasUnreadConversations)
                    {
                        <span class="rgf-recroby-unread" aria-hidden="true"></span>
                    }
                    <i class="bi bi-chevron-down" aria-hidden="true"></i>
                </RgfButton>
            }
            <RgfButton CssClass="btn-outline-secondary" OnClick="BeginRename"
                       Tooltip="@RecroDict.GetRgfRecrobyString("RenameConversation")"
                       AdditionalAttributes="@(new() { ["data-action"] = "rename", ["aria-label"] = RenameLabel })"><i class="bi bi-pencil-square" aria-hidden="true"></i></RgfButton>
            <RgfButton CssClass="btn-outline-secondary" OnClick="NewConversation"
                       Tooltip="@RecroDict.GetRgfRecrobyString("NewConversation")"
                       AdditionalAttributes="@(new() { ["data-action"] = "new", ["aria-label"] = RecroDict.GetRgfRecrobyString("NewConversation") })"><i class="bi bi-plus-lg" aria-hidden="true"></i></RgfButton>
            <div id="@(_selectorId + "-list")" class="rgf-recroby-switcher" popover="manual" hidden="@(!_switcherOpen)" role="dialog" aria-label="@RecroDict.GetRgfRecrobyString("Conversations")">
                @if (_conversations.Count > 8)
                {
                    <input type="search" class="form-control" aria-label="@RecroDict.GetRgfRecrobyString("SearchConversations")" placeholder="@RecroDict.GetRgfRecrobyString("SearchConversations")" @bind="_search" @bind:event="oninput" />
                }
                <div class="rgf-recroby-switcher-list">
                    @foreach (var group in FilteredConversations.GroupBy(c => c.RecrobyType))
                    {
                        <div role="group" aria-label="@(HasMultipleTypes ? TypeLabel(group.Key) : RecroDict.GetRgfRecrobyString("Conversations"))" data-conversation-type="@group.Key">
                            @if (HasMultipleTypes)
                            {
                                <div class="rgf-recroby-group-title">@TypeLabel(group.Key)</div>
                            }
                            @foreach (var conversation in group)
                            {
                                <div class="rgf-recroby-choice @(conversation == _active ? "active" : "")" @key="conversation.Id">
                                    <RgfHtml TagName="button" CssClass="rgf-recroby-choice-select" OnClick="() => SelectConversation(conversation)"
                                             Tooltip="@HtmlEncoder.Default.Encode(DisplayTitle(conversation))"
                                             AdditionalAttributes="@(new() { ["type"] = "button", ["data-action"] = "select", ["aria-controls"] = $"recroby-panel-{conversation.Id:N}", ["aria-pressed"] = (conversation == _active).ToString().ToLowerInvariant(), ["data-bs-container"] = $"#{_selectorId}-list" })">
                                        <span class="rgf-recroby-choice-title">@DisplayTitle(conversation)</span>
                                        @if (conversation.HasUnreadResponse)
                                        {
                                            <span class="rgf-recroby-unread" aria-hidden="true"></span>
                                            <span class="visually-hidden"> @RecroDict.GetRgfRecrobyString("ConversationUnread")</span>
                                        }
                                        @if (conversation == _active)
                                        {
                                            <i class="bi bi-check-lg" aria-hidden="true"></i>
                                        }
                                    </RgfHtml>
                                    @{
                                        var closeLabel = RecroDict.GetRgfRecrobyString("CloseConversationNamed", DisplayTitle(conversation));
                                    }
                                    <RgfHtml TagName="button" CssClass="btn-close" OnClick="() => CloseConversation(conversation)"
                                             Tooltip="@HtmlEncoder.Default.Encode(closeLabel)"
                                             AdditionalAttributes="@(new() { ["type"] = "button", ["aria-label"] = closeLabel, ["data-bs-container"] = $"#{_selectorId}-list" })" />
                                </div>
                            }
                        </div>
                    }
                    @if (!FilteredConversations.Any())
                    {
                        <p class="p-2 mb-0" role="status">@(RecroDict.GetRgfRecrobyString("NoConversations"))</p>
                    }
                </div>
            </div>
        </div>
        @foreach (var conversation in _conversations)
        {
            <div @key="conversation.Id" id="@($"recroby-panel-{conversation.Id:N}")" class="rgf-recroby-conversation" hidden="@(conversation != _active)" role="region" aria-label="@ConversationLabel(conversation)">
                <RgfRecrobyComponent @ref="conversation.Component" Session="conversation.Session" />
            </div>
        }
        <RgfHtml TagName="div" CssClass="rgf-recroby-resize"
                 Tooltip="@RecroDict.GetRgfRecrobyString("ResizeRecroby")"
                 AdditionalAttributes="@(new() { ["data-resize-handle"] = "", ["role"] = "separator", ["aria-label"] = RecroDict.GetRgfRecrobyString("ResizeRecroby"), ["tabindex"] = "0" })" />
    </section>
</div>

@code {
    /// <summary>CSS anchor name shared with the adjacent Toast container by the owning Root.</summary>
    [Parameter]
    public string? ToastAnchorName { get; set; }

    /// <summary>Application content that shares available space with the docked desktop panel.</summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
