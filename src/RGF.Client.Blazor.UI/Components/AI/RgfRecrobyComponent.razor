@* RGF-DOC: rgf.client.blazor-ui.ai-chat *@
@* RGF-DOC: rgf.client.recroby.integration *@
<RgfAiChatComponent @ref="_chat" Session="ActiveSession" SendFailed="SendFailed" ShowSendErrors="true" AllowCancellation="true"
                    InputFooter="Selectors" UseSubtleMessageStyle="true" ShowCopyConversation="true" ShowUserMessageCopy="true" />

@code {
    private RenderFragment Selectors => @<div class="rgf-recroby-selectors" @ref="_element">
        @if (_catalog?.Providers.Count > 0)
        {
            <RgfButton CssClass="btn-outline-secondary" Disabled="@(SelectionDisabled)"
                       Tooltip="@RecroDict.GetRgfRecrobyString("ProviderModel")"
                       AdditionalAttributes="@(new() { ["popovertarget"] = _selectorId + "-model", ["aria-label"] = RecroDict.GetRgfRecrobyString("ProviderModel"), ["aria-expanded"] = "false" })">
                <i class="bi bi-cpu me-1" aria-hidden="true"></i>
                @Provider?.Id / @Model?.Id ▾
            </RgfButton>
            <RgfButton CssClass="btn-outline-secondary" Disabled="@(SelectionDisabled)"
                       Tooltip="@RecroDict.GetRgfRecrobyString("ReasoningEffort")"
                       AdditionalAttributes="@(new() { ["popovertarget"] = _selectorId + "-effort", ["aria-label"] = RecroDict.GetRgfRecrobyString("ReasoningEffort"), ["aria-expanded"] = "false" })">
                <i class="bi bi-lightbulb me-1" aria-hidden="true"></i>
                @DisplayEffort ▾
            </RgfButton>
            <div id="@(_selectorId + "-model")" class="rgf-recroby-selection-panel" popover="auto" role="dialog" aria-label="@RecroDict.GetRgfRecrobyString("ProviderModel")">
                <RgfComboBox TValue="string" Label="@RecroDict.GetRgfRecrobyString("Provider")" @bind-Value="SelectedProvider"
                             DataSource="ProviderItems" Disabled="SelectionDisabled" />
                <RgfComboBox TValue="string" Label="@RecroDict.GetRgfRecrobyString("Model")" @bind-Value="SelectedModel"
                             DataSource="ModelItems" Disabled="SelectionDisabled"
                             AdditionalAttributes="@(new() { { "data-close-popover", "" } })" />
            </div>
            <div id="@(_selectorId + "-effort")" class="rgf-recroby-selection-panel" popover="auto" role="dialog" aria-label="@RecroDict.GetRgfRecrobyString("ReasoningEffort")">
                <RgfComboBox TValue="string" Label="@RecroDict.GetRgfRecrobyString("ReasoningEffort")" @bind-Value="SelectedEffort"
                             DataSource="EffortItems" Disabled="SelectionDisabled"
                             AdditionalAttributes="@(new() { { "data-close-popover", "" } })" />
            </div>
        }
        <RgfButton CssClass="btn-outline-secondary" Disabled="@(SelectionDisabled)"
                   Tooltip="@RecroDict.GetRgfRecrobyString("ResponseFormat")"
                   AdditionalAttributes="@(new() { ["popovertarget"] = _selectorId + "-format", ["aria-label"] = RecroDict.GetRgfRecrobyString("ResponseFormat"), ["aria-expanded"] = "false" })">
            <i class="bi bi-markdown me-1" aria-hidden="true"></i>
            @DisplayFormat ▾
        </RgfButton>
        <div id="@(_selectorId + "-format")" class="rgf-recroby-selection-panel" popover="auto" role="dialog" aria-label="@RecroDict.GetRgfRecrobyString("ResponseFormat")">
            <RgfComboBox TValue="string" Label="@RecroDict.GetRgfRecrobyString("ResponseFormat")" @bind-Value="SelectedFormat"
                         DataSource="FormatItems" Disabled="SelectionDisabled"
                         AdditionalAttributes="@(new() { { "data-close-popover", "" } })" />
        </div>
    </div>;
}
