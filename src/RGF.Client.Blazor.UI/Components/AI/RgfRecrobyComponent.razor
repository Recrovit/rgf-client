@using Recrovit.RecroGridFramework.Client.AI
@using Recrovit.RecroGridFramework.Client.AI.Transport
@inject IServiceProvider Services

@* RGF-DOC: rgf.client.recroby.integration *@
<RgfAiChatComponent Session="@(Session ?? _session!)" SendFailed="SendFailed" ShowSendErrors="true" AllowCancellation="true" />

@code {
    [Parameter]
    public EventCallback<Exception> SendFailed { get; set; }

    [Parameter]
    public RgfAiConversationSession? Session { get; set; }

    private RgfAiConversationSession? _session;

    protected override void OnParametersSet()
    {
        if (Session == null)
        {
            _session ??= new RgfAiConversationSession(new RgfAiApiTransport(
                Microsoft.Extensions.DependencyInjection.ServiceProviderServiceExtensions.GetRequiredService<IRgfApiService>(Services)));
        }
    }
}
