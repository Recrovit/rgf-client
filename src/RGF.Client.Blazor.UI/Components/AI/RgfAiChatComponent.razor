@using Recrovit.RecroGridFramework.Abstraction.Contracts.AI

<div class="container mt-4">
    <div class="chat-box d-flex flex-column">
        @for (var messageIndex = 0; messageIndex < Session.Conversation.Messages.Count; messageIndex++)
        {
            var message = Session.Conversation.Messages[messageIndex];
            var hasMarkdownView = message.Role == RgfAiMessageRole.Assistant && message is RgfAiResponse formatted
                && formatted.ResponseFormat is RgfAiResponseFormat.Minimal or RgfAiResponseFormat.Normal or RgfAiResponseFormat.Maximum;
            <div @key="(Session, messageIndex, message)" class="@($"message {(message.Role == RgfAiMessageRole.User ? "text-bg-primary align-self-end" : "text-bg-secondary align-self-start")}{(hasMarkdownView ? " rgf-ai-markdown" : "")}")">
                @if (hasMarkdownView)
                {
                    <RgfMarkdownViewer @key="(Session, message)" Text="@message.Message" RenderMarkdown="true" ShowToggle="true" />
                }
                else
                {
                    <div class="rgf-ai-plain">@message.Message</div>
                }
            </div>
            @if (message.Role == RgfAiMessageRole.Assistant && message is RgfAiResponse response)
            {
                <RgfAiUsageSummary @key="(Session, messageIndex, response)" Response="response" />
                @if (HasChoices && ReferenceEquals(response, PendingResponse))
                {
                    <fieldset class="rgf-ai-choices align-self-start mt-2" disabled="@Session.IsProcessing">
                        <legend class="fs-6">Choose a response</legend>
                        @foreach (var choice in response.Choices!)
                        {
                            <label class="rgf-ai-choice card p-2 mb-2 @(ReferenceEquals(_selectedChoice, choice) ? "border-primary bg-primary-subtle" : "")">
                                <span class="d-flex align-items-start gap-2">
                                    <input type="radio" class="form-check-input flex-shrink-0" name="@(InputId + "-choices")"
                                           checked="@ReferenceEquals(_selectedChoice, choice)" disabled="@Session.IsProcessing"
                                           @onchange="() => SelectChoice(response, choice)" />
                                    <span class="rgf-ai-plain">@choice.UserText</span>
                                </span>
                            </label>
                        }
                        <button type="button" class="btn btn-success" disabled="@(Session.IsProcessing || _selectedChoice is null)"
                                @onclick="ConfirmChoiceAsync">Confirm response</button>
                    </fieldset>
                }
            }
        }
        @if (Session.IsProcessing)
        {
            <SpinnerComponent Style="width: 2rem; height: 2rem;" />
        }
        @if ((_errorKind == "configuration" || _errorKind == "credit") && _sendError != null)
        {
            <div class="alert alert-warning mt-2 mb-0" role="alert" data-error-kind="@_errorKind">@_sendError</div>
            @if (_failedResponse is not null)
            {
                <RgfAiUsageSummary @key="_failedResponse" Response="_failedResponse" />
            }
        }
    </div>
    <div class="input-group mt-3">
        <RgfInputText Id="@InputId" @bind-Value="Prompt" Multiline="true" Disabled="TextInputDisabled" />
    </div>
    @if (InputFooter is null)
    {
        @InputControls
    }
    else
    {
        <div class="rgf-ai-actions">
            @InputControls
            @InputFooter
        </div>
    }
    @if ((ShowSendErrors || _errorKind == "continuation") && _sendError != null && _errorKind != "configuration" && _errorKind != "credit")
    {
        <div class="alert @(_errorKind == "workflow" || _errorKind == "continuation" ? "alert-warning" : "alert-danger") mt-2 mb-0" role="alert" data-error-kind="@_errorKind">@_sendError</div>
        @if (_failedResponse is not null)
        {
            <RgfAiUsageSummary @key="_failedResponse" Response="_failedResponse" />
        }
    }
</div>

@code {
    private RenderFragment InputControls => @<text>
        <RgfButton CssClass="btn-success m-1 align-self-start rgf-ai-action-icon"
                   Title="Send" AdditionalAttributes="@(new() { { "aria-label", "Send" } })" OnClick="OnSendAsync" Disabled="TextInputDisabled">
            <i class="bi bi-send" aria-hidden="true"></i>
        </RgfButton>
        @if (AllowCancellation && Session.IsProcessing && _sendCancellation != null)
        {
            <button type="button" class="btn btn-outline-danger m-1 align-self-start rgf-ai-action-icon"
                    @onclick="CancelSend" title="Cancel request" aria-label="Cancel request">
                <i class="bi bi-stop-circle" aria-hidden="true"></i>
            </button>
        }
    </text>;
}
