@using Recrovit.RecroGridFramework.Abstraction.Contracts.AI

<div class="container mt-4">
    <div class="chat-box d-flex flex-column">
        @for (var messageIndex = 0; messageIndex < Session.Conversation.Messages.Count; messageIndex++)
        {
            var message = Session.Conversation.Messages[messageIndex];
            <div class="message @(message.Role == RgfAiMessageRole.User ? "text-bg-primary align-self-end" : "text-bg-secondary align-self-start")">
                @message.Message
            </div>
            @if (message.Role == RgfAiMessageRole.Assistant && message is RgfAiResponse response)
            {
                <RgfAiUsageSummary @key="(Session, messageIndex, response)" Response="response" />
            }
        }
        @if (Session.IsProcessing)
        {
            <SpinnerComponent Style="width: 2rem; height: 2rem;" />
        }
        @if ((_errorKind == "configuration" || _errorKind == "credit") && _sendError != null)
        {
            <div class="alert alert-warning mt-2 mb-0" role="alert" data-error-kind="@_errorKind">@_sendError</div>
            @if (_failedResponse is not null)
            {
                <RgfAiUsageSummary @key="_failedResponse" Response="_failedResponse" />
            }
        }
    </div>
    <div class="input-group mt-3">
        <RgfInputText Id="@InputId" @bind-Value="Prompt" Multiline="true" />
    </div>
    @if (InputFooter is null)
    {
        @InputControls
    }
    else
    {
        <div class="rgf-ai-actions">
            @InputControls
            @InputFooter
        </div>
    }
    @if (ShowSendErrors && _sendError != null && _errorKind != "configuration" && _errorKind != "credit")
    {
        <div class="alert @(_errorKind == "workflow" ? "alert-warning" : "alert-danger") mt-2 mb-0" role="alert" data-error-kind="@_errorKind">@_sendError</div>
        @if (_failedResponse is not null)
        {
            <RgfAiUsageSummary @key="_failedResponse" Response="_failedResponse" />
        }
    }
</div>

@code {
    private RenderFragment InputControls => @<text>
        <RgfButton CssClass="btn-success m-1 align-self-start rgf-ai-action-icon"
                   Title="Send" AdditionalAttributes="@(new() { { "aria-label", "Send" } })" OnClick="OnSendAsync" Disabled="Session.IsProcessing">
            <i class="bi bi-send" aria-hidden="true"></i>
        </RgfButton>
        @if (AllowCancellation && Session.IsProcessing && _sendCancellation != null)
        {
            <button type="button" class="btn btn-outline-danger m-1 align-self-start rgf-ai-action-icon"
                    @onclick="CancelSend" title="Cancel request" aria-label="Cancel request">
                <i class="bi bi-stop-circle" aria-hidden="true"></i>
            </button>
        }
    </text>;
}
