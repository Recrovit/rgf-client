@using Recrovit.RecroGridFramework.Abstraction.Contracts.AI

<div class="container mt-4">
    <div class="chat-box d-flex flex-column">
        @foreach (var message in Session.Conversation.Messages)
        {
            <div class="message @(message.Role == RgfAiMessageRole.User ? "text-bg-primary align-self-end" : "text-bg-secondary align-self-start")">
                @message.Message
            </div>
        }
        @if (Session.IsProcessing)
        {
            <SpinnerComponent Style="width: 2rem; height: 2rem;" />
        }
        @if ((_errorKind == "configuration" || _errorKind == "credit") && _sendError != null)
        {
            <div class="alert alert-warning mt-2 mb-0" role="alert" data-error-kind="@_errorKind">@_sendError</div>
        }
    </div>
    <div class="input-group mt-3">
        <RgfInputText Id="@InputId" @bind-Value="Prompt" Multiline="true" />
    </div>
    @if (InputFooter is null)
    {
        @InputControls
    }
    else
    {
        <div class="rgf-ai-actions">
            @InputControls
            @InputFooter
        </div>
    }
    @if (ShowSendErrors && _sendError != null && _errorKind != "configuration" && _errorKind != "credit")
    {
        <div class="alert @(_errorKind == "workflow" ? "alert-warning" : "alert-danger") mt-2 mb-0" role="alert" data-error-kind="@_errorKind">@_sendError</div>
    }
</div>

@code {
    private RenderFragment InputControls => @<text>
        <RgfButton CssClass="btn-primary m-1 align-self-start"
                   MinWidth="5rem" Label="Send" OnClick="OnSendAsync" Disabled="Session.IsProcessing" />
        @if (AllowCancellation && Session.IsProcessing && _sendCancellation != null)
        {
            <button type="button" class="btn btn-outline-secondary m-1 align-self-start"
                    @onclick="CancelSend" aria-label="Cancel request">Cancel</button>
        }
    </text>;
}
