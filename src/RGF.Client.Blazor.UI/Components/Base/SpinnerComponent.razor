<div class="@ContainerClass" style="z-index:5000">
    <div class="@SpinnerClass" style="@EffectiveStyle" role="status">
        @if (string.IsNullOrEmpty(EffectiveStatus))
        {
            <span class="visually-hidden">@EffectiveText</span>
        }
    </div>
    @if (!string.IsNullOrEmpty(EffectiveStatus))
    {
        <div>@EffectiveStatus</div>
    }
</div>

@code {
    [Parameter]
    public RgfLoadingIndicatorParameters? LoadingIndicatorParameters { get; set; }

    [Parameter]
    public string ContainerClass { get; set; } = "spinner-container";

    [Parameter]
    public string SpinnerClass { get; set; } = "spinner-border text-primary";

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public string Text { get; set; } = "Loading...";

    [Parameter]
    public string? Status { get; set; }

    private string EffectiveText => LoadingIndicatorParameters?.Text ?? Text;

    private string? EffectiveStatus => LoadingIndicatorParameters?.Status ?? Status;

    private string? EffectiveStyle => LoadingIndicatorParameters?.Style ?? Style;
}
