@inherits RgfBaseComponent
@* RGF-DOC: rgf.client.blazor-ui.markdown-viewer *@
@{
    var buttonCssClass = "btn";
    if (Small)
    {
        buttonCssClass += " btn-sm";
    }
}
<div class="rgf-markdown-viewer @CssClass" style="@Style">
    @if (ShowCopy || ShowToggle)
    {
        <div class="rgf-markdown-toolbar">
            @if (ShowCopy)
            {
                <RgfHtml TagName="button" Disabled="@(string.IsNullOrEmpty(Text) || _copying)" OnClick="CopyAsync"
                         Tooltip="@RecroDict.GetRgfUiString("Copy")"
                         AdditionalAttributes="@(new() { ["type"] = "button", ["class"] = $"{buttonCssClass} rgf-markdown-copy", ["aria-label"] = RecroDict.GetRgfUiString("Copy"), ["onmouseleave"] = EventCallback.Factory.Create<MouseEventArgs>(this, ResetCopyFeedback) })">
                    <i class="bi @(_copied ? "bi-check-lg" : "bi-copy")" aria-hidden="true"></i>
                </RgfHtml>
            }
            @if (ShowToggle)
            {
                <RgfHtml TagName="button" OnClick="ToggleView"
                         Tooltip="@ToggleLabel"
                         AdditionalAttributes="@(new() { ["type"] = "button", ["class"] = $"{buttonCssClass} rgf-markdown-toggle", ["aria-label"] = ToggleLabel, ["aria-pressed"] = _renderMarkdown ? "true" : "false" })">
                    <i class="bi @(_renderMarkdown ? "bi-file-text" : "bi-markdown")" aria-hidden="true"></i>
                </RgfHtml>
            }
        </div>
    }
    @if (_renderMarkdown)
    {
        <div class="rgf-markdown-content">@((MarkupString)_html)</div>
    }
    else
    {
        <div class="rgf-markdown-plain">@Text</div>
    }
    @if (ShowCopy)
    {
        <div class="rgf-markdown-copy-status visually-hidden" role="status" aria-live="polite">@(_copied ? RecroDict.GetRgfUiString("Copied") : null)</div>
        @if (_copyFailed)
        {
            <div class="rgf-markdown-copy-error small" role="alert">@(RecroDict.GetRgfUiString("ClipboardCopyFailed"))</div>
        }
    }
</div>
