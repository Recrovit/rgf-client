@using ApexCharts
@using Recrovit.RecroGridFramework.Blazor.RgfApexCharts.Components
@* RGF-DOC: rgf.client.blazor-ui.entity-ui *@

<RgfChartComponent @ref="RgfChartRef" EntityParameters="EntityParameters" Embedded="Embedded">
    <ContentTemplate Context="RgfCharComp">
        @if (DataOnly)
        {
            <div class="rgf-apexchart-container h-100">
                @if (RgfCharComp.ChartDataGrid != null)
                {
                    @RgfCharComp.ChartDataGrid
                }
                else
                {
                    <SpinnerComponent Style="width: 1rem; height: 1rem;" />
                }
            </div>
        }
        else
        {
            @if (IsWorkspace)
            {
                <ChartWorkspaceView Chart="RgfCharComp" ShowControls="@(!HideChartControls)" HasConfiguration="_workspaceHasConfiguration" IsEditing="_workspaceIsEditing" IsProcessing="IsChartProcessing"
                                    OnSelected="OnWorkspaceSettingSelectedAsync" OnNew="() => OnWorkspaceDraft(false)"
                                    OnCopy="() => OnWorkspaceDraft(true)" OnEdit="ToggleWorkspaceSettings" OnRedraw="OnRedrawChartAsync"
                                    SettingsContent="SettingsEditor(RgfCharComp)" ChartContent="ChartDisplay(RgfCharComp)" />
            }
            else
            {
                <ChartDialogView SettingsContent="SettingsEditor(RgfCharComp)" ChartContent="ChartDisplay(RgfCharComp)" />
            }
        }
    </ContentTemplate>

    <FooterTemplate Context="RgfCharComp">
        @if (!IsWorkspace)
        {
            <ChartDialogView Chart="RgfCharComp" ShowControls="@(!HideChartControls)" FooterContent="ChartActions(RgfCharComp)"
                             SaveContent="SaveControls(RgfCharComp)" OnSelected="arg => OnChartSettingsChanged(arg.Key as int?, arg.Value)" />
        }
    </FooterTemplate>
</RgfChartComponent>

@inherits BaseChartComponent
@inject IRecroSecService RecroSec
@code {
    private RenderFragment<RgfChartComponent> SettingsEditor => RgfCharComp => @<text>
            @if (!HideChartControls)
            {
                <div class="rgf-apexchart-settings accordion pb-2">
                    <div class="accordion-item">
                        <h2 class="accordion-header">
                            <button type="button" class="accordion-button" data-bs-toggle="collapse" data-bs-target="#@_panelId" aria-expanded="true" aria-controls="@_panelId"
                                    @onclick="(arg) => OnSettingsAccordionToggled()">
                                @RecroDict.GetRgfUiString("Settings")
                            </button>
                        </h2>
                        <div id="@_panelId" class="accordion-collapse collapse@(SettingsAccordionActive ? " show" : "")">
                            <div class="accordion-body">
                                <EditForm EditContext="RgfCharComp.EditContext" OnValidSubmit="OnCreateChart">
                                    <div class="d-flex justify-content-start border border-light-subtle overflow-auto">
                                        <div class="p-1 col-2 text-center">
                                            <div class="fw-bold">Y @RgfCharComp.GetRecroDictChart("Axis").ToLower()</div>
                                            <div class="small">@RgfCharComp.GetRecroDictChart("SelectDataColumns")</div>
                                        </div>
                                        @for (int i = 0; i < RgfCharComp.ChartSettings.AggregationSettings.Columns.Count; i++)
                                        {
                                            var idx = i;
                                            var col = RgfCharComp.ChartSettings.AggregationSettings.Columns[idx];
                                            var sortState = RgfCharComp.GetColumnSortState(col);
                                            <div class="p-1 col-auto">
                                                <ValidationMessage For="@(() => col.Aggregate)" />
                                                <ValidationMessage For="@(() => col.Id)" />
                                                <ValidationMessage For="@(() => col.Sort)" />
                                                <RgfComboBox TValue="string"
                                                             Items="RgfAggregationColumn.AllowedAggregates"
                                                             @bind-Value="col.Aggregate"
                                                             OnValueChanging="() => RgfCharComp.SetDataStatus(RgfProcessingStatus.Invalid)" />
                                                @if (col.Aggregate != "Count")
                                                {
                                                    <RgfComboBox TValue="int"
                                                                 DataSource="RgfCharComp.GetAllowedAggregationColumns(col.Aggregate)"
                                                                 @bind-Value="col.Id"
                                                                 OnValueChanging="() => RgfCharComp.SetDataStatus(RgfProcessingStatus.Invalid)" />
                                                }
                                                <div class="mt-1">
                                                    <div class="input-group-text">@RgfCharComp.GetRecroDictChart("LimitRanking")</div>
                                                    <RgfInputNumber TValue="int?" Tooltip="@RgfCharComp.GetRecroDictChart("LimitRankingTooltip")"
                                                                    Value="sortState.Priority" ValueExpression="() => sortState.Priority"
                                                                    ValueChanged="(value) => RgfCharComp.SetColumnSortPriority(col, value)"
                                                                    HideSpinButton="true"
                                                                    Min="1" />

                                                    <div class="col-sm-2 checkbox-lg">
                                                        <RgfCheckBox Label="@RecroDict.GetRgfUiString("Descending")"
                                                                     Value="sortState.Descending" ValueExpression="() => sortState.Descending"
                                                                     ValueChanged="(value) => RgfCharComp.SetColumnSortDescending(col, value)"
                                                                     Disabled="@(col.Sort == 0)" />
                                                    </div>

                                                </div>
                                            </div>
                                            @if (i != 0 || RgfCharComp.ChartSettings.AggregationSettings.Columns.Count > 1)
                                            {
                                                <div class="p-1 col-auto">
                                                    <RgfButton Label="-" CssClass="btn-outline-primary" OnClick="(arg) => RgfCharComp.RemoveColumn(col)" />
                                                </div>
                                            }
                                        }
                                        <div class="p-1 col-auto">
                                            <RgfButton Label="+" CssClass="btn-outline-primary" OnClick="(arg) => RgfCharComp.AddColumn()" />
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-start border border-light-subtle overflow-auto">
                                        <div class="p-1 col-2 text-center">
                                            <div class="fw-bold">X @RgfCharComp.GetRecroDictChart("Axis").ToLower()</div>
                                            <div class="small">@RgfCharComp.GetRecroDictChart("GroupValues")</div>
                                        </div>
                                        @for (int i = 0; i < RgfCharComp.ChartSettings.AggregationSettings.GroupsOrEmpty.Count; i++)
                                        {
                                            var idx = i;
                                            <div class="p-1 col-auto">
                                                <ValidationMessage For="@(() => RgfCharComp.ChartSettings.AggregationSettings.GroupsOrEmpty[idx])" />
                                                <RgfComboBox TValue="int"
                                                             DataSource="RgfCharComp.AllowedProperties.OrderBy(e => e.ColTitle).ToDictionary(p => p.Id, p => p.ColTitle)"
                                                             @bind-Value="RgfCharComp.ChartSettings.AggregationSettings.GroupsOrEmpty[idx].Id"
                                                             OnValueChanging="() => RgfCharComp.SetDataStatus(RgfProcessingStatus.Invalid)" />
                                            </div>
                                            <div class="p-1 col-auto">
                                                <RgfButton Label="-" CssClass="btn-outline-primary" OnClick="(arg) => RgfCharComp.RemoveAtGroup(idx)" />
                                            </div>
                                        }
                                        <div class="p-1 col-auto">
                                            <RgfButton Label="+" CssClass="btn-outline-primary" OnClick="(arg) => RgfCharComp.AddGroup()" />
                                        </div>
                                    </div>
                                    <div class="d-flex justify-content-start border border-light-subtle overflow-auto">
                                        <div class="p-1 col-2 text-center">
                                            <div class="fw-bold">@RgfCharComp.GetRecroDictChart("AdditionalGrouping")</div>
                                            <div class="small">@RgfCharComp.GetRecroDictChart("SeriesGrouping")</div>
                                        </div>
                                        @for (int i = 0; i < RgfCharComp.ChartSettings.AggregationSettings.SubGroupsOrEmpty.Count; i++)
                                        {
                                            var idx = i;
                                            <div class="p-1 col-auto">
                                                <ValidationMessage For="@(() => RgfCharComp.ChartSettings.AggregationSettings.SubGroupsOrEmpty[idx])" />
                                                <RgfComboBox TValue="int"
                                                             DataSource="RgfCharComp.AllowedProperties.OrderBy(e => e.ColTitle).ToDictionary(p => p.Id, p => p.ColTitle)"
                                                             @bind-Value="RgfCharComp.ChartSettings.AggregationSettings.SubGroupsOrEmpty[idx].Id"
                                                             OnValueChanging="() => RgfCharComp.SetDataStatus(RgfProcessingStatus.Invalid)" />
                                            </div>
                                            <div class="p-1 col-auto">
                                                <RgfButton Label="-" CssClass="btn-outline-primary" OnClick="(arg) => RgfCharComp.RemoveAtSubGroup(idx)" />
                                            </div>
                                        }
                                        <div class="p-1 col-auto">
                                            <RgfButton Label="+" CssClass="btn-outline-primary" OnClick="(arg) => RgfCharComp.AddSubGroup()" />
                                        </div>
                                    </div>
                                    <div class="row gx-3 gy-2 align-items-center">
                                        <div class="col-sm-3">
                                            <div class="input-group">
                                                <div class="input-group-text">@RgfCharComp.GetRecroDictChart("Limit")</div>
                                                <RgfInputNumber TValue="int?" Tooltip="@RgfCharComp.GetRecroDictChart("LimitTooltip")"
                                                                Value="RgfCharComp.ChartSettings.AggregationSettings.Take"
                                                                ValueExpression="() => RgfCharComp.ChartSettings.AggregationSettings.Take"
                                                                ValueChanged="(value) => { RgfCharComp.ChartSettings.AggregationSettings.Take = value; RgfCharComp.SetDataStatus(RgfProcessingStatus.Invalid); }"
                                                                HideSpinButton="true"
                                                                Min="1" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row gx-3 gy-2 align-items-center">
                                        <div class="col-sm-3">
                                            <div class="input-group">
                                                <div class="input-group-text">@RecroDict.GetRgfUiString("ChartType")</div>
                                                <RgfComboBox TValue="RgfChartSeriesType"
                                                             DataSource="EnumExtensions.ToDictionary<RgfChartSeriesType>()"
                                                             @bind-Value="RgfCharComp.ChartSettings.SeriesType"
                                                             OnValueChanging="(e) => ChangeChartType(e.NewValue)" />
                                            </div>
                                            <ValidationMessage For="@(() => RgfCharComp.ChartSettings.SeriesType)" />
                                        </div>
                                        <div class="col-sm-2 checkbox-lg">
                                            <RgfCheckBox Label="@RecroDict.GetRgfUiString("Stacked")" Disabled="@(RgfCharComp.ChartSettings.SeriesType != RgfChartSeriesType.Bar)"
                                                         Value="RgfCharComp.ChartSettings.Stacked" ValueExpression="() => RgfCharComp.ChartSettings.Stacked"
                                                         ValueChanged="ChangedStacked" />
                                        </div>
                                        <div class="col-sm-2 checkbox-lg">
                                            <RgfCheckBox Label="@RecroDict.GetRgfUiString("Horizontal")" Disabled="@(RgfCharComp.ChartSettings.SeriesType != RgfChartSeriesType.Bar)"
                                                         Value="RgfCharComp.ChartSettings.Horizontal" ValueExpression="() => RgfCharComp.ChartSettings.Horizontal"
                                                         ValueChanged="ChangedHorizontal" />
                                        </div>
                                        <div class="col-sm-2 checkbox-lg">
                                            <RgfCheckBox Label="@RgfCharComp.GetRecroDictChart("Legend")"
                                                         Value="RgfCharComp.ChartSettings.Legend" ValueExpression="() => RgfCharComp.ChartSettings.Legend"
                                                         ValueChanged="ChangedLegend"
                                                         Disabled="@(RgfCharComp.ChartSettings.SeriesType == RgfChartSeriesType.Card)" />
                                        </div>
                                        <div class="col-sm-2 checkbox-lg">
                                            <RgfCheckBox Label="@RgfCharComp.GetRecroDictChart("ShowDataLabels")"
                                                         Value="RgfCharComp.ChartSettings.ShowDataLabels" ValueExpression="() => RgfCharComp.ChartSettings.ShowDataLabels"
                                                         ValueChanged="ChangedShowDataLabels" />
                                        </div>
                                    </div>
                                    <div class="rgf-apexchart-settings row gx-3 gy-2 align-items-center">
                                        <div class="col-sm-3">
                                            <div class="input-group">
                                                <div class="input-group-text">@RecroDict.GetRgfUiString("Theme")</div>
                                                <RgfComboBox TValue="Mode?"
                                                             DataSource="EnumExtensions.ToNullableDictionary<Mode>()"
                                                             Value="ApexChartSettings.Options.Theme.Mode" ValueExpression="() => ApexChartSettings.Options.Theme.Mode"
                                                             ValueChanged="ChangeTheme" />
                                            </div>
                                        </div>
                                        <div class="col-sm-3">
                                            <div class="input-group">
                                                <div class="input-group-text">@RgfCharComp.GetRecroDictChart("Palette")</div>
                                                <RgfComboBox TValue="string"
                                                             Items="ColorPalettes"
                                                             Value="RgfCharComp.ChartSettings.Palette" ValueExpression="() => RgfCharComp.ChartSettings.Palette"
                                                             ValueChanged="ChangePalette" />
                                            </div>
                                        </div>
                                        <div class="col-sm-3">
                                            <div class="input-group">
                                                <div class="input-group-text">@RecroDict.GetRgfUiString("Width")</div>
                                                <RgfInputNumber TValue="int?" Value="RgfCharComp.ChartSettings.Width" ValueExpression="() => RgfCharComp.ChartSettings.Width"
                                                                ValueChanged="ChangedWidth" />
                                            </div>
                                        </div>
                                        <div class="col-sm-3">
                                            <div class="input-group">
                                                <div class="input-group-text">@RecroDict.GetRgfUiString("Height")</div>
                                                <RgfInputNumber TValue="int?" Value="RgfCharComp.ChartSettings.Height" ValueExpression="() => RgfCharComp.ChartSettings.Height"
                                                                ValueChanged="ChangedHeight" />
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row gx-3 gy-2 align-items-center">
                                        <div class="col-sm">
                                            <RgfInputText Label="@RecroDict.GetRgfUiString("Remark")"
                                                          @bind-Value="RgfCharComp.ChartSettings.Remark" Multiline="true" />
                                        </div>
                                    </div>
                                </EditForm>
                                @if (IsWorkspace)
                                {
                                    <div class="rgf-chart-workspace-save d-flex flex-wrap align-items-center gap-2 mt-2">
                                        <div class="rgf-chart-workspace-name d-flex flex-wrap align-items-center gap-2">
                                            <RgfInputText Label="@RecroDict.GetRgfUiString("SavedName")" LabelCssClass="mb-0 text-nowrap" Width="30rem"
                                                          @bind-Value="RgfCharComp.ChartSettings.SettingsName"
                                                          Disabled="@(RgfCharComp.ChartSettings.IsReadonly == true)" />
                                        </div>
                                        @SaveControls(RgfCharComp)
                                        <div class="rgf-chart-workspace-data-actions">
                                            @ChartDataActions(RgfCharComp)
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
    </text>;

    private RenderFragment<RgfChartComponent> ChartDisplay => RgfCharComp => @<text>
            <div id="@ContainerId" class="@(Embedded ? "rgf-apexchart-container rgf-apexchart-container-embedded card" : "rgf-apexchart-container card")">
                @if (!Embedded)
                {
                    <div class="rgf-apexchart-header dialog-header card-header">
                        <ul class="nav nav-tabs card-header-tabs" id="@_tabsId" role="tablist">
                            <li class="nav-item" role="presentation">
                                <button type="button" class="nav-link@(ActiveTabIndex == RecroChartTab.Grid ? " active" : "")"
                                        id="@($"{_tabsId}-tab-{RecroChartTab.Grid}")"
                                        data-bs-toggle="tab" data-bs-target="@($"#{_tabsId}-tab-{RecroChartTab.Grid}-pane")" role="tab"
                                        @onclick="(e) => OnTabActivated(RecroChartTab.Grid)">
                                    @RgfCharComp.GetRecroDictChart("DataSet")
                                </button>
                            </li>
                            <li class="nav-item" role="presentation">
                                <button type="button" class="nav-link@(ActiveTabIndex == RecroChartTab.Chart ? " active" : "")"
                                        id="@($"{_tabsId}-tab-{RecroChartTab.Chart}")"
                                        data-bs-toggle="tab" data-bs-target="@($"#{_tabsId}-tab-{RecroChartTab.Chart}-pane")" role="tab"
                                        @onclick="(e) => OnTabActivated(RecroChartTab.Chart)">
                                    @RecroDict.GetRgfUiString("Chart")
                                </button>
                            </li>
                        </ul>
                    </div>
                }
                <div class="@(Embedded ? "card-body rgf-apexchart-card-body-embedded" : "card-body")">
                    <div class="@(Embedded ? "tab-content rgf-apexchart-tab-content-embedded" : "tab-content")">
                        <div id="@($"{_tabsId}-tab-{RecroChartTab.Grid}-pane")" class="@(Embedded ? $"tab-pane fade rgf-apexchart-tab-pane-embedded show{(ActiveTabIndex == RecroChartTab.Grid ? " active" : "")}" : $"tab-pane fade show{(ActiveTabIndex == RecroChartTab.Grid ? " active" : "")}")" role="tabpanel" tabindex="0">
                            @if (IsWorkspace && !HideChartControls && ActiveTabIndex == RecroChartTab.Grid && RgfCharComp.DataStatus != RgfProcessingStatus.Valid)
                            {
                                <div class="rgf-chart-workspace-dataset d-flex justify-content-start p-3">
                                    @DataSetAction(RgfCharComp)
                                </div>
                            }
                            @if (RgfCharComp.ChartDataGrid != null)
                            {
                                @if (IsWorkspace)
                                {
                                    <div class="rgf-chart-workspace-dataset-grid" hidden="@(RgfCharComp.DataStatus != RgfProcessingStatus.Valid)">
                                        @RgfCharComp.ChartDataGrid
                                    </div>
                                }
                                else
                                {
                                    @RgfCharComp.ChartDataGrid
                                }
                            }
                            else
                            {
                                <SpinnerComponent Style="width: 1rem; height: 1rem;" />
                            }
                        </div>
                        <div id="@($"{_tabsId}-tab-{RecroChartTab.Chart}-pane")" class="@ApexChartComponentClass" role="tabpanel" tabindex="0">
                            @if (IsWorkspace && !HideChartControls && ActiveTabIndex == RecroChartTab.Chart && RgfCharComp.ChartStatus != RgfProcessingStatus.Valid)
                            {
                                <div class="rgf-chart-workspace-create d-flex justify-content-start p-3">
                                    @CreateChartAction(RgfCharComp)
                                </div>
                            }
                            <div style="visibility:@(RgfCharComp.ChartStatus == RgfProcessingStatus.Valid ? "visible" : "hidden")">
                                <ApexChartComponent @ref=ApexChartRef ChartSettings="@ApexChartSettings" />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
    </text>;

    private RenderFragment<RgfChartComponent> ChartActions => RgfCharComp => @<text>
                    <div class="p-1">
                        <RgfButton CssClass="btn-primary" MinWidth="5rem" Label="@RecroDict.GetRgfUiString("Redraw")" Disabled="RgfCharComp.ChartStatus != RgfProcessingStatus.Valid"
                                   OnClick="(arg) => OnRedrawChartAsync()" />
                    </div>
                    @ChartDataActions(RgfCharComp)
    </text>;

    private RenderFragment<RgfChartComponent> CreateChartAction => RgfCharComp => @<text>
                    <div class="p-1">
                        <RgfButton CssClass="btn-primary" MinWidth="5rem" Label="@RgfCharComp.GetRecroDictChart("CreateChart")" Disabled="RgfCharComp.ChartStatus != RgfProcessingStatus.Invalid || RgfCharComp.DataStatus == RgfProcessingStatus.InProgress || IsWorkspace && IsChartProcessing"
                                   OnClick="(arg) => OnCreateChart()" />
                    </div>
    </text>;

    private RenderFragment<RgfChartComponent> DataSetAction => RgfCharComp => @<text>
                    <div class="p-1">
                        <RgfButton CssClass="btn-primary" MinWidth="5rem" Label="@RgfCharComp.GetRecroDictChart("DataSet")" Disabled="RgfCharComp.DataStatus != RgfProcessingStatus.Invalid || IsWorkspace && IsChartProcessing"
                                   OnClick="(arg) => OnGetData()" />
                    </div>
    </text>;

    private RenderFragment<RgfChartComponent> ChartDataActions => RgfCharComp => @<text>
                    @CreateChartAction(RgfCharComp)
                    @DataSetAction(RgfCharComp)
    </text>;

    private RenderFragment<RgfChartComponent> SaveControls => RgfCharComp => @<text>
                    <div class="rg-predef-save">
                        <div class="ps-1" style="width:max-content;">
                            <RgfComboBox TValue="string" @bind-Value="RgfCharComp.ChartSettings.RoleId" DataSource="RecroSec.Roles" IncludeEmptyItem="true"
                                         Tooltip="@RecroDict.GetRgfUiString("RoleVisibilitySettingTooltip")"
                                         Disabled="RgfCharComp.ChartSettings.IsReadonly == true || !RgfCharComp.IsPublicChartSettingAllowed || string.IsNullOrEmpty(RgfCharComp.ChartSettings.SettingsName)" />
                        </div>
                        <div class="px-1">
                            <RgfButton IconName="bi-floppy" CssClass="btn-success" Tooltip="@RecroDict.GetRgfUiString("SaveChartSettings")"
                                       Disabled="RgfCharComp.ChartSettings.IsReadonly == true || string.IsNullOrEmpty(RgfCharComp.ChartSettings.SettingsName) || !RgfCharComp.IsPublicChartSettingAllowed && RgfCharComp.ChartSettings.RoleId != null"
                                       OnClick="(arg) => RgfCharComp.SaveChartSettingsAsync()" />
                            <RgfButton IconName="bi-trash" CssClass="btn-danger" Tooltip="@RecroDict.GetRgfUiString("DeleteSavedSettings")"
                                       Disabled="RgfCharComp.ChartSettings.IsReadonly == true || RgfCharComp.ChartSettings.ChartSettingsId == null || !RgfCharComp.IsPublicChartSettingAllowed && RgfCharComp.ChartSettings.RoleId != null"
                                       OnClick="(arg) => RgfCharComp.OnDeleteChartSettingsAsync()" />
                        </div>
                    </div>
    </text>;

    private async Task OnWorkspaceSettingSelectedAsync(int? id)
    {
        if (IsChartProcessing) return;
        _workspaceIsEditing = false;
        if (id == null)
        {
            _workspaceHasConfiguration = false;
            RgfChartRef.SetDataStatus(RgfProcessingStatus.Invalid);
            return;
        }
        var setting = RgfChartRef.ChartSettingList.FirstOrDefault(setting => setting.ChartSettingsId == id);
        if (setting == null) return;
        _workspaceHasConfiguration = true;
        ChangeChartProcessing(1);
        try
        {
            await OnChartSettingsChanged(id, setting.SettingsName);
        }
        finally
        {
            ChangeChartProcessing(-1);
        }
    }

    private void OnWorkspaceDraft(bool copyCurrent)
    {
        _workspaceHasConfiguration = true;
        RgfChartRef.CreateChartSettings(copyCurrent);
        Initialize(_chartSettings);
        OpenWorkspaceSettings();
    }

    private void ToggleWorkspaceSettings()
    {
        if (_workspaceIsEditing)
        {
            _workspaceIsEditing = false;
            _workspaceActivationPending = true;
        }
        else
        {
            OpenWorkspaceSettings();
        }
    }

    private void OpenWorkspaceSettings()
    {
        _workspaceIsEditing = true;
        SettingsAccordionActive = true;
        _workspaceActivationPending = true;
    }

    private readonly string _tabsId = RgfBaseComponent.GetNextId();
    private readonly string _panelId = RgfBaseComponent.GetNextId();
    private bool IsWorkspace => !Embedded && EntityParameters.ChartParameters.PresentationMode == RgfChartPresentationMode.Workspace;
    private bool _workspaceHasConfiguration;
    private bool _workspaceIsEditing;
    private int _chartProcessingCount;
    private bool IsChartProcessing => _chartProcessingCount > 0;

    private void ChangeChartProcessing(int change)
    {
        _chartProcessingCount += change;
        if (!_workspaceDisposed) StateHasChanged();
    }

    private bool _workspaceActivationPending;
    private bool _workspaceDisposed;
    private Task<IJSObjectReference>? _workspaceModuleTask;

    protected override void OnInitialized()
    {
        _workspaceHasConfiguration = IsWorkspace && InitialChartSettingsId > 0;
        base.OnInitialized();
        EntityParameters.ChartParameters.EventDispatcher.Subscribe(RgfChartEventKind.LayoutCommitted, OnLayoutCommittedAsync, this);
        EntityParameters.ChartParameters.EventDispatcher.Subscribe(RgfChartEventKind.WorkspaceActivated, OnWorkspaceActivatedAsync, this);
        EntityParameters.ChartParameters.EventDispatcher.Subscribe(RgfChartEventKind.Initialized, OnWorkspaceActivatedAsync, this);
    }

    private Task OnWorkspaceActivatedAsync(IRgfEventArgs<RgfChartEventArgs> args)
    {
        if (!IsWorkspace || _workspaceDisposed) return Task.CompletedTask;
        if (args.Args.EventKind == RgfChartEventKind.Initialized && InitialChartSettingsId > 0)
        {
            _workspaceHasConfiguration = RgfChartRef?.ChartSettings.ChartSettingsId == InitialChartSettingsId;
        }
        _workspaceActivationPending = true;
        return InvokeAsync(StateHasChanged);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (IsWorkspace && !_workspaceDisposed && _workspaceActivationPending &&
            EntityParameters.DisplayMode == RfgDisplayMode.Chart && RgfChartRef != null)
        {
            _workspaceActivationPending = false;
            await OnInitSizeAsync();
        }
    }

    protected override async Task<bool> OnCreateChart()
    {
        if (IsWorkspace && !_workspaceHasConfiguration) return false;
        ChangeChartProcessing(1);
        try
        {
            return await base.OnCreateChart();
        }
        finally
        {
            ChangeChartProcessing(-1);
        }
    }

    protected override async Task<bool> OnGetData()
    {
        ChangeChartProcessing(1);
        try
        {
            return await base.OnGetData();
        }
        finally
        {
            ChangeChartProcessing(-1);
        }
    }

    private async Task OnRedrawChartAsync()
    {
        ChangeChartProcessing(1);
        try
        {
            await OnRedraw();
        }
        finally
        {
            ChangeChartProcessing(-1);
        }
    }

    protected override async Task UpdateChart(bool suppressToast = false)
    {
        ChangeChartProcessing(1);
        try
        {
            await base.UpdateChart(suppressToast);
        }
        finally
        {
            ChangeChartProcessing(-1);
        }
    }

    protected override void OnTabActivated(RecroChartTab tab)
    {
        base.OnTabActivated(tab);
        if (IsWorkspace && tab == RecroChartTab.Chart) _workspaceActivationPending = true;
    }

    protected override async Task OnInitSizeAsync(bool recreate = false)
    {
        if (IsWorkspace)
        {
            if (_workspaceDisposed || !_workspaceHasConfiguration || EntityParameters.DisplayMode != RfgDisplayMode.Chart) return;
            _selfRef ??= DotNetObjectReference.Create<BaseChartComponent>(this);
            // Import the same standalone asset in Debug and Release.
            _workspaceModuleTask ??= _jsRuntime.InvokeAsync<IJSObjectReference>("import",
                $"{RgfClientConfiguration.AppRootPath}/_content/Recrovit.RecroGridFramework.Client.Blazor.UI/Components/ChartWorkspace.js").AsTask();
            var module = await _workspaceModuleTask;
            if (!_workspaceDisposed && module != null)
                await module.InvokeVoidAsync("activate", ContainerId, _selfRef);
            return;
        }
        if (Embedded && !DataOnly)
        {
            if (recreate)
            {
                SettingsAccordionActive = true;
                Initialize(_chartSettings);
            }

            if (_selfRef == null)
            {
                _selfRef = Microsoft.JSInterop.DotNetObjectReference.Create<Recrovit.RecroGridFramework.Blazor.RgfApexCharts.Components.BaseChartComponent>(this);
            }

            var initialized = await _jsRuntime.InvokeAsync<bool>(
                $"{RGFClientBlazorUIConfiguration.JsBlazorUiNamespace}.Chart.initialize",
                ResizeHostId ?? ContainerId,
                ContainerId,
                _selfRef);

            if (initialized)
            {
                await _jsRuntime.InvokeAsync<bool>(
                    $"{RGFClientBlazorUIConfiguration.JsBlazorUiNamespace}.Chart.resizePreview",
                    ResizeHostId ?? ContainerId,
                    ContainerId,
                    _selfRef);

                await _jsRuntime.InvokeAsync<bool>(
                    $"{RGFClientBlazorUIConfiguration.JsBlazorUiNamespace}.Chart.commitResize",
                    ResizeHostId ?? ContainerId,
                    ContainerId,
                    _selfRef);
                return;
            }

            _selfRef?.Dispose();
            _selfRef = null;
        }

        await base.OnInitSizeAsync(recreate);
    }

    public override Task Resize(int width, int height) => ResizeCommit(width, height);

    public override Task ResizePreview(int width, int height) => ApplyResize(width, height, redraw: false);

    public override Task ResizeCommit(int width, int height) => ApplyResize(width, height, redraw: true);

    protected override async Task ApplyResize(int width, int height, bool redraw)
    {
        if (IsWorkspace)
        {
            if (_workspaceDisposed || !_workspaceHasConfiguration || EntityParameters.DisplayMode != RfgDisplayMode.Chart ||
                width <= 0 || height <= 0 || ActiveTabIndex != RecroChartTab.Chart || RgfChartRef == null) return;
            ApexChartSettings.Width = _chartSettings.Width ?? Math.Max(width - 2, 100);
            ApexChartSettings.Height = _chartSettings.Height ?? Math.Max(height - 50, 100);
            StateHasChanged();
            if (redraw && RgfChartRef.ChartStatus == RgfProcessingStatus.Valid && _workspaceModuleTask != null)
            {
                var module = await _workspaceModuleTask;
                if (!_workspaceDisposed && module != null)
                    await module.InvokeVoidAsync("resize", ApexChartSettings.Options.Chart.Id, ApexChartSettings.Width, ApexChartSettings.Height);
            }
            return;
        }
        if (Embedded && !DataOnly)
        {
            if (ActiveTabIndex != RecroChartTab.Chart || RgfChartRef == null)
            {
                return;
            }

            ApexChartSettings.Width = width < 1 ? null : Math.Max(width, 100);
            ApexChartSettings.Height = height < 1 ? null : Math.Max(height, 100);
            RgfChartRef.ChartSettings.Width = ApexChartSettings.Width;
            RgfChartRef.ChartSettings.Height = ApexChartSettings.Height;
            StateHasChanged();

            if (redraw && RgfChartRef.DataStatus == RgfProcessingStatus.Valid)
            {
                await UpdateChart(EntityParameters.ChartParameters.SuppressAutomaticChartToast);
            }

            return;
        }

        await base.ApplyResize(width - 2, height - 10, redraw);
    }

    private async Task OnLayoutCommittedAsync(IRgfEventArgs<RgfChartEventArgs> args)
    {
        if (!Embedded || DataOnly)
        {
            return;
        }

        if (_selfRef == null)
        {
            await OnInitSizeAsync();
            return;
        }

        await _jsRuntime.InvokeAsync<bool>(
            $"{RGFClientBlazorUIConfiguration.JsBlazorUiNamespace}.Chart.commitResize",
            ResizeHostId ?? ContainerId,
            ContainerId,
            _selfRef);
    }

    private string ApexChartComponentClass => Embedded
        ? $"rgf-apexchart-content rgf-apexchart-content-embedded tab-pane fade show{(ActiveTabIndex == RecroChartTab.Chart ? " active " : " ")}{ApexChartSettings.ChartType.ToString().ToLowerInvariant()}"
        : $"rgf-apexchart-content tab-pane fade show{(ActiveTabIndex == RecroChartTab.Chart ? " active " : " ")}{ApexChartSettings.ChartType.ToString().ToLowerInvariant()}";

    public override async ValueTask DisposeAsync()
    {
        _workspaceDisposed = true;
        if (_workspaceModuleTask != null)
        {
            try
            {
                var module = await _workspaceModuleTask;
                if (module != null)
                {
                    await module.InvokeVoidAsync("destroy", ContainerId);
                    await module.DisposeAsync();
                }
            }
            catch (JSDisconnectedException) { }
        }
        if (Embedded && !DataOnly)
        {
            await _jsRuntime.InvokeVoidAsync(
                $"{RGFClientBlazorUIConfiguration.JsBlazorUiNamespace}.Chart.destroy",
                ContainerId);
        }

        await base.DisposeAsync();
    }
}
